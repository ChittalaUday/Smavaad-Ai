{
  "name": "smavaad-ai-root",
  "version": "1.0.0",
  "description": "Root management for Smavaad AI services",
  "scripts": {
    "start:all": "npx pm2 start ecosystem.config.js",
    "pm2:all": "npm run start:all",
    "stop:all": "npx pm2 stop ecosystem.config.js",
    "restart:all": "npx pm2 restart ecosystem.config.js",
    "delete:all": "npx pm2 delete ecosystem.config.js",
    "status": "npx pm2 status",
    "logs": "npx pm2 logs"
  },
  "devDependencies": {
    "pm2": "^6.0.14"
  }
}
